pipeline {
  agent any

  environment {
    VENV_DIR = 'venv'
  }

  stages {
    stage('Clone') {
      steps {
        git 'https://github.com/samia04s/python-jenkins-demo.git'
      }
    }

    stage('Setup Python Env') {
      steps {
        sh 'python3 -m venv $VENV_DIR'
        sh './$VENV_DIR/bin/pip install --upgrade pip'
        sh './$VENV_DIR/bin/pip install -r requirements.txt'
      }
    }

    stage('Run Tests') {
      steps {
        sh './$VENV_DIR/bin/python -m pytest'
      }
    }

    stage('Deploy') {
      steps {
        echo '✅ Deployment placeholder – success!'
      }
    }
  }
}
